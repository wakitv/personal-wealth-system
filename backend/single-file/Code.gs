      c.rows = c.rows.concat(rows);
    },
    update: function (name, keyField, id, patch) {
      var c = load(name);
      var ki = c.headers.indexOf(keyField);
      for (var i = 0; i < c.rows.length; i++) {
        if (String(c.rows[i][ki]) === String(id) || (c.rows[i][ki] instanceof Date && decode(name, c.rows[i], c.headers)[keyField] === id)) {
          var merged = decode(name, c.rows[i], c.headers);
          Object.keys(patch).forEach(function (k) { merged[k] = patch[k]; });
          var row = encode(name, merged, c.headers);
          c.sh.getRange(i + 2, 1, 1, c.headers.length).setValues([row]);
          c.rows[i] = row;
          return decode(name, row, c.headers);
        }
      }
      throw new Error(name + ' row ' + id + ' not found');
    }
  };
}


// ===== Code.gs =====
/**
 * Personal Wealth OS — Apps Script web app entry points.
 *
 * Deploy: Deploy → New deployment → Web app
 *   Execute as:      Me (the spreadsheet owner)
 *   Who has access:  Anyone
 * "Anyone" only makes the URL reachable; every action except `health` requires a
 * verified Google ID token for an allow-listed email (see Auth.gs). The spreadsheet
 * itself stays private and is never shared.
 *
 * Requests: POST, Content-Type text/plain (avoids a CORS preflight), JSON body:
 *   { action, idToken, requestId, payload }
 */
var PWOS_SERVICE_ = null;
function service_() {
  return PWOS_SERVICE_ || (PWOS_SERVICE_ = createWealthService(WealthCore));
}

function buildDeps_() {
  var svc = service_();
  var ss = getSpreadsheet_();
  var tz = Session.getScriptTimeZone() || 'Asia/Manila';
  return {
    store: SheetStore_(ss, svc.SCHEMA, tz),
    now: function () { return Date.now(); },
    uuid: function () { return Utilities.getUuid(); },
    withLock: function (fn) {
      var lock = LockService.getScriptLock();
      if (!lock.tryLock(25000)) throw new svc.ApiError('BUSY', 'Another update is in progress. Please retry.');
      try { var r = fn(); SpreadsheetApp.flush(); return r; } finally { lock.releaseLock(); }
    },
    authenticate: function (token) { return authenticate_(token, svc); },
    http: { getJson: function (url) { return fetchJson_(url, svc); } },
    log: function (e) { console.error(e && e.stack ? e.stack : e); }
  };
}

/**
 * Server-side fetch for market data. If the optional COINGECKO_API_KEY script property holds a
 * free CoinGecko "Demo" key, it is sent as a header (it never reaches the browser).
 */
function fetchJson_(url, svc) {
  var headers = { Accept: 'application/json' };
  var key = PropertiesService.getScriptProperties().getProperty('COINGECKO_API_KEY');
  var isCoinGecko = url.indexOf('https://api.coingecko.com/') === 0;
  if (isCoinGecko && key) headers['x-cg-demo-api-key'] = key.trim();
  var res;
  try { res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, headers: headers }); }
  catch (e) { throw new svc.ApiError('UPSTREAM', 'Could not reach the price source: ' + e.message); }
  var code = res.getResponseCode();
  if (code === 200) return JSON.parse(res.getContentText());
  if (isCoinGecko && code === 429) {
    throw new svc.ApiError('UPSTREAM', key
      ? 'CoinGecko rate limit reached. Wait a minute and try again.'
      : 'CoinGecko is limiting requests from Google servers (HTTP 429). Get a free Demo API key at coingecko.com/en/api and add it as script property COINGECKO_API_KEY.');
  }
  if (isCoinGecko && (code === 401 || code === 403)) {
    throw new svc.ApiError('UPSTREAM', key
      ? 'CoinGecko rejected the API key in COINGECKO_API_KEY (HTTP ' + code + '). Check it is a Demo key copied in full.'
      : 'CoinGecko refused the request (HTTP ' + code + '). Add a free Demo API key as script property COINGECKO_API_KEY.');
  }
  throw new svc.ApiError('UPSTREAM', 'Price source returned HTTP ' + code);
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  var req;
  try {
    var body = e && e.postData && e.postData.contents;
    if (!body || body.length > 2000000) return json_({ ok: false, error: { code: 'VALIDATION', message: 'Empty or oversized request' } });
    req = JSON.parse(body);
  } catch (err) {
    return json_({ ok: false, error: { code: 'VALIDATION', message: 'Request body must be JSON' } });
  }
  try {
    return json_(service_().handle(req, buildDeps_()));
  } catch (err) {
    console.error(err && err.stack ? err.stack : err);
    return json_({ ok: false, error: setupProblem_(err) });
  }
}

/**
 * Explain setup problems precisely. These messages describe configuration only — never data —
 * so they are safe to show before sign-in.
 */
function setupProblem_(err) {
  var msg = String(err && err.message || err);
  if (/SPREADSHEET_ID/.test(msg)) {
    return { code: 'MISCONFIGURED', message: 'The database is not set up yet: SPREADSHEET_ID is empty. In the Apps Script editor run setupDatabase, then try again.' };
  }
  if (/openById|not found|Requested entity|permission/i.test(msg)) {
    return { code: 'MISCONFIGURED', message: 'The backend cannot open its spreadsheet. Check the SPREADSHEET_ID script property (run setupDatabase if unsure).' };
  }
  if (/Worksheet|header row|missing column/i.test(msg)) {
    return { code: 'MISCONFIGURED', message: msg };
  }
  return { code: 'INTERNAL', message: 'Server configuration error. Check the Apps Script execution log (Executions, left sidebar).' };
}

/** GET only serves the public health check. No financial data is ever returned over GET. */
function doGet(e) {
  var action = e && e.parameter && e.parameter.action;
  if (action === 'health') {
    try { return json_(service_().handle({ action: 'health' }, buildDeps_())); }
    catch (err) { return json_({ ok: false, error: setupProblem_(err) }); }
  }
  return json_({ ok: true, data: { service: 'Personal Wealth OS API', hint: 'POST JSON {action, idToken, requestId, payload}' } });
}


// ===== Setup.gs =====
/**
 * One-time setup and maintenance helpers. Run these from the Apps Script editor
 * (select the function in the toolbar → Run). They run as you, the owner.
 */

/**
 * Creates (or migrates) every worksheet with headers, frozen header row,
 * plain-text formatting for text columns, and default settings.
 * If SPREADSHEET_ID is not set, a new private spreadsheet is created and its ID saved.
 */
function setupDatabase() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('SPREADSHEET_ID');
  var ss;
  if (!id) {
    ss = SpreadsheetApp.create('Personal Wealth OS — Database');
    props.setProperty('SPREADSHEET_ID', ss.getId());
    console.log('Created spreadsheet ' + ss.getUrl());
  } else {
    ss = SpreadsheetApp.openById(id);
  }
  ss.setSpreadsheetTimeZone('Asia/Manila');
  var svc = service_();
  svc.SHEETS.forEach(function (name) {
    var cols = svc.SCHEMA[name].cols;
    var sh = ss.getSheetByName(name) || ss.insertSheet(name);
    var lastCol = Math.max(1, sh.getLastColumn());
    var existing = sh.getLastRow() >= 1 ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(String).filter(String) : [];
    var headers = existing.slice();
    cols.forEach(function (c) { if (headers.indexOf(c[0]) < 0) headers.push(c[0]); });
    sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold').setBackground('#0f172a').setFontColor('#e2e8f0');
    sh.setFrozenRows(1);
    var maxRows = Math.max(sh.getMaxRows(), 2);
    var types = {}; cols.forEach(function (c) { types[c[0]] = c[1]; });
    headers.forEach(function (h, i) {
      var range = sh.getRange(2, i + 1, maxRows - 1, 1);
      if (types[h] === 'n') range.setNumberFormat('0.########');
      else if (types[h] === 's' || types[h] === 'j') range.setNumberFormat('@');
    });
    var protection = sh.protect().setDescription('Managed by Personal Wealth OS — edit through the app');
    protection.setWarningOnly(true); // warns before accidental manual edits; the app is the source of truth
  });
  var blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);
  // Default settings (only keys that are not set yet)
  var store = SheetStore_(ss, svc.SCHEMA, 'Asia/Manila');
  var have = {}; store.read('Settings').forEach(function (r) { have[r.key] = 1; });
  var now = new Date().toISOString();
  var rows = Object.keys(svc.DEFAULT_SETTINGS).filter(function (k) { return !have[k]; }).map(function (k) { return { key: k, value: svc.DEFAULT_SETTINGS[k], updated_at: now }; });
  store.append('Settings', rows);
  console.log('Database ready: ' + ss.getUrl());
  return ss.getUrl();
}

/** Verifies configuration and a formula-injection-safe write/read round trip. Leaves no data behind except an audit row. */
function selfTest() {
  var cfg = getConfig_();
  var problems = [];
  if (!cfg.spreadsheetId) problems.push('SPREADSHEET_ID not set');
  if (!/\.apps\.googleusercontent\.com$/.test(cfg.clientId)) problems.push('GOOGLE_CLIENT_ID missing or malformed');
  if (!cfg.allowedEmails.length) problems.push('ALLOWED_EMAILS not set');
  var ss = getSpreadsheet_();
  var svc = service_();
  svc.SHEETS.forEach(function (s) { if (!ss.getSheetByName(s)) problems.push('Missing worksheet ' + s); });
  var file = DriveApp.getFileById(ss.getId());
  var access = file.getSharingAccess();
  if (access !== DriveApp.Access.PRIVATE) problems.push('Spreadsheet sharing is ' + access + ' — set it to Restricted (private).');
  var store = SheetStore_(ss, svc.SCHEMA, 'Asia/Manila');
  var probe = '=1+1 selftest ' + Utilities.getUuid().slice(0, 8);
  store.append('AuditLog', [{ audit_id: 'SELFTEST-' + Date.now(), at: new Date().toISOString(), actor: 'selfTest', action: 'SELFTEST', entity: 'Store', entity_id: 'probe', request_id: '', before_json: probe, after_json: '' }]);
  var fresh = SheetStore_(ss, svc.SCHEMA, 'Asia/Manila');
  var back = fresh.read('AuditLog').filter(function (r) { return r.before_json === probe; });
  if (back.length !== 1) problems.push('Text round trip failed (formula guard)');
  var result = problems.length ? 'PROBLEMS:\n- ' + problems.join('\n- ') : 'All checks passed.';
  console.log(result);
  return result;
}


// ===== Snapshots.gs =====
/**
 * Daily snapshots via a time-driven trigger.
 *
 * Run installDailySnapshotTrigger() once from the editor. Every night at ~23:50
 * Asia/Manila it fills any missing days since the last snapshot and (re)computes
 * today's snapshot from the ledger and recorded prices. Snapshots are reproducible:
 * "Rebuild snapshots" in Settings recomputes them exactly the same way.
 *
 * If price auto-refresh is enabled in Settings, prices are fetched first.
 */
function dailySnapshotJob() {
  var svc = service_();
  var deps = buildDeps_();
  var settings = {};
  deps.store.read('Settings').forEach(function (r) { settings[r.key] = r.value; });
  if (settings.price_auto_refresh === 'true') {
    try { svc.runInternal('refreshPrices', {}, deps, 'system:daily'); }
    catch (e) { console.warn('Price refresh failed: ' + e.message); }
  }
  var tz = settings.timezone || 'Asia/Manila';
  var today = WealthCore.localDate(Date.now(), tz);
  var snaps = deps.store.read('DailySnapshots').map(function (s) { return String(s.snapshot_date); }).sort();
  var last = snaps.length ? snaps[snaps.length - 1] : null;
  var from = last && last < today ? WealthCore.addDays(last, 1) : today;
  if (WealthCore.daysBetween(from, today) > 1000) from = WealthCore.addDays(today, -1000);
  var res = svc.runInternal('rebuildSnapshots', { from: from, to: today }, buildDeps_(), 'system:daily');
  console.log('Snapshots written: ' + JSON.stringify(res));
  return res;
}

function installDailySnapshotTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'dailySnapshotJob') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('dailySnapshotJob').timeBased().atHour(23).nearMinute(50).everyDays(1).inTimezone('Asia/Manila').create();
  console.log('Daily snapshot trigger installed (≈23:50 Asia/Manila).');
}

function removeDailySnapshotTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'dailySnapshotJob') ScriptApp.deleteTrigger(t);
  });
}
